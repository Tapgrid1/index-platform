# ─── Database ────────────────────────────────────────────────────────────
# DATABASE_URL is the connection every request uses. Behind a pooler (Supabase,
# Neon) point it at the transaction pooler and append `?pgbouncer=true`, which
# tells Prisma to stop using prepared statements the pooler cannot handle.
DATABASE_URL="postgresql://user:password@localhost:5432/index_platform?schema=public"
# Direct connection, used only by `prisma db push` and `prisma migrate` — the
# pooler cannot run DDL. With no pooler in play, set it to the same value.
DIRECT_URL="postgresql://user:password@localhost:5432/index_platform?schema=public"

# ─── Auth.js ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Shopper social auth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Apple's client secret is a signed ES256 JWT, not a static string — it is
# minted from the four values below (see src/lib/appleSecret.ts). AUTH_APPLE_ID
# is the Services ID. Leave these unset and Apple sign-in stays off; the other
# providers are unaffected.
AUTH_APPLE_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""   # .p8 contents; literal \n escapes are accepted
# Legacy fallback, used only when the four values above are absent.
AUTH_APPLE_SECRET=""

# ─── Email ───────────────────────────────────────────────────────────────
# With no API key set, sends are written to the server log instead — the app
# runs fine, and nothing disappears silently. See src/lib/email.ts.
RESEND_API_KEY=""
EMAIL_FROM="the index <no-reply@example.com>"

# ─── Admin bootstrap ─────────────────────────────────────────────────────
# Seeded admin account. Change the password immediately after first login.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# ─── Resolver ────────────────────────────────────────────────────────────
# Where /r/:code sends a scan when the code is unknown or expired.
RESOLVER_FALLBACK_URL="http://localhost:3000"
