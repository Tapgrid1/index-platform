# ─── Database ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/index_platform?schema=public"

# ─── Auth.js ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Public origin used for sitemap.xml, robots.txt and links inside emails.
# Falls back to AUTH_URL, which already has to be right for OAuth callbacks.
SITE_URL=""

# ─── OAuth providers ─────────────────────────────────────────────────────
# The ONLY way anyone signs in — shoppers, merchants and admins alike. There
# are no passwords in this product.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Apple's client secret is a signed ES256 JWT, not a static string — it is
# minted from the four values below (see src/lib/appleSecret.ts). AUTH_APPLE_ID
# is the Services ID. Leave these unset and Apple sign-in stays off; the other
# providers are unaffected.
AUTH_APPLE_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""   # .p8 contents; literal \n escapes are accepted
# Legacy fallback, used only when the four values above are absent.
AUTH_APPLE_SECRET=""

# ─── Email ───────────────────────────────────────────────────────────────
# With no API key set, sends are written to the server log instead — the app
# runs fine, and nothing disappears silently. See src/lib/email.ts.
RESEND_API_KEY=""
EMAIL_FROM="the index <no-reply@example.com>"

# ─── Admin access ────────────────────────────────────────────────────────
# Comma-separated allowlist. An account holds ADMIN if and only if its OAuth
# email is listed here — re-derived on every token rotation, so removing an
# address demotes that account on its next request. Unset grants nobody admin.
#
# This is deploy configuration rather than a database flag on purpose: a row
# can be written by anything with database access; this needs a deploy.
ADMIN_EMAILS="admin@example.com"

# ─── Development sign-in ─────────────────────────────────────────────────
# Set to "enabled" to expose a passwordless, email-only sign-in so the app is
# usable locally without registering an OAuth client first.
#
# It is impossible to enable in production: src/auth.ts requires BOTH this flag
# and NODE_ENV !== production, and `next start` always sets NODE_ENV=production.
# src/auth.test.ts asserts it. Leave unset unless you are running `next dev`.
DEV_AUTH=""

# ─── Resolver ────────────────────────────────────────────────────────────
# Where /r/:code sends a scan when the code is unknown or expired.
RESOLVER_FALLBACK_URL="http://localhost:3000"
