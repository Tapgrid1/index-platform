# ─── Database ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/index_platform?schema=public"

# ─── Auth.js ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Shopper social auth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# ─── Admin bootstrap ─────────────────────────────────────────────────────
# Seeded admin account. Change the password immediately after first login.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# ─── Resolver ────────────────────────────────────────────────────────────
# Where /r/:code sends a scan when the code is unknown or expired.
RESOLVER_FALLBACK_URL="http://localhost:3000"
